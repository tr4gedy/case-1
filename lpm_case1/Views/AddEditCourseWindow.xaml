<Window x:Class="lpm_case1.Views.AddEditCourseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:lpm_case1.Models"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="550" Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="321*"/>
            <ColumnDefinition Width="239*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Название курса*" FontWeight="Bold" Margin="0,0,0,5" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                 Height="30" Margin="0,0,0,10" Grid.ColumnSpan="2"/>

        <TextBlock Grid.Row="2" Text="Описание" FontWeight="Bold" Margin="0,0,0,5" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="3" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                 Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" Grid.ColumnSpan="2"/>

        <TextBlock Grid.Row="4" Text="Категория" FontWeight="Bold" Margin="0,0,0,5" Grid.ColumnSpan="2"/>
        <ComboBox Grid.Row="5" ItemsSource="{Binding Categories}" 
                  SelectedItem="{Binding Category}" 
                  Height="30" Margin="0,0,0,10" Grid.ColumnSpan="2"/>

        <TextBlock Grid.Row="6" Text="Уровень сложности" FontWeight="Bold" Margin="0,0,0,5" Grid.ColumnSpan="2"/>
        <ComboBox Grid.Row="7" ItemsSource="{Binding DifficultyLevels}" 
                  SelectedItem="{Binding DifficultyLevel}" 
                  Height="30" Margin="0,0,0,10" Grid.ColumnSpan="2"/>

        <Grid Grid.Row="8" Margin="0,0,0,10" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Продолжительность (часы)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding TotalDuration, UpdateSourceTrigger=PropertyChanged}" 
                         Height="30"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Прогресс (%)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Progress, UpdateSourceTrigger=PropertyChanged}" 
                         Height="30"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="9" Text="Ссылка на материалы" FontWeight="Bold" Margin="0,0,0,5" Grid.ColumnSpan="2"/>
        <TextBox Grid.Row="10" Text="{Binding ResourceLink, UpdateSourceTrigger=PropertyChanged}" 
                 Height="30" Margin="0,34,0,44" Grid.ColumnSpan="2"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Left" Grid.Column="1" Margin="29,108,0,0" Grid.RowSpan="2">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" 
                    Width="100" Height="30" Margin="0,0,10,0" 
                    Background="#FF4CAF50" Foreground="White"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" 
                    Width="100" Height="30" 
                    Background="#FF9E9E9E" Foreground="White"/>
        </StackPanel>

        <!-- Валидация ошибок -->
        <Border Grid.Row="1" Grid.RowSpan="11" BorderBrush="Red" BorderThickness="1" 
                Visibility="{Binding HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#FFF0F0F0" CornerRadius="5" Opacity="0.9" Height="473" VerticalAlignment="Top" Grid.ColumnSpan="2">
            <TextBlock Text="{Binding ErrorMessages}" Foreground="Red" Margin="10"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
<Window x:Class="lpm_case1.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:lpm_case1.Converters"
        xmlns:local="clr-namespace:lpm_case1.Views"
        mc:Ignorable="d"
        Title="Learning Progress Manager" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска и фильтрации -->
        <Border BorderBrush="#FFEEEEEE" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <Grid Width="250" Margin="0,0,15,0">
                    <TextBox x:Name="SearchBox" 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Height="32" Padding="10,0,0,0" BorderBrush="#FFDDDDDD" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="PlaceholderText" Text="Поиск курсов..." IsHitTestVisible="False"
                               Foreground="#FF999999" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding ElementName=SearchBox, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <ComboBox ItemsSource="{Binding Categories}" 
                          SelectedItem="{Binding SelectedCategoryFilter}"
                          Width="180" Height="32" Margin="0,0,15,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Content="Поиск" Command="{Binding FilterCoursesCommand}" 
                        Width="150" Height="32" Background="#FF9C27B0" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Список курсов -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  RowHeight="40" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderBrush="#FFDDDDDD" BorderThickness="1" VerticalContentAlignment="Center">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="*" />
                <DataGridTemplateColumn Header="Прогресс" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="5,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="20" 
                                             VerticalAlignment="Center">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="Foreground" Value="#FF2196F3"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Progress}" Value="0">
                                                    <Setter Property="Foreground" Value="#FF9E9E9E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Progress}" Value="100">
                                                    <Setter Property="Foreground" Value="#FF9C27B0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}" 
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" />
                <DataGridTextColumn Header="Сложность" Binding="{Binding DifficultyLevel}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель действий -->
        <Border Grid.Row="2" BorderBrush="#FFEEEEEE" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Добавить" Command="{Binding OpenAddCourseDialogCommand}" 
                        Width="100" Height="35" Margin="0,0,10,0" Background="#FF9C27B0" Foreground="White"/>
                <Button Content="Редактировать" Command="{Binding OpenEditCourseDialogCommand}" 
                        Width="100" Height="35" Margin="0,0,10,0" Background="#FF9C27B0" Foreground="White"
                        IsEnabled="{Binding SelectedCourse, Converter={StaticResource NullToBooleanConverter}}"/>
                <Button Content="Удалить" Command="{Binding DeleteCourseCommand}" 
                        Width="100" Height="35" Margin="0,0,20,0" Background="#FF9C27B0" Foreground="White"
                        IsEnabled="{Binding SelectedCourse, Converter={StaticResource NullToBooleanConverter}}"/>

                <StackPanel>
                    <TextBlock Text="Быстрый прогресс:" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <UniformGrid Columns="5" Margin="0,5,0,0">
                        <Button Content="0%" Command="{Binding QuickSetProgressCommand}" CommandParameter="0" Margin="2" Background="#FF9C27B0" Foreground="White"/>
                        <Button Content="25%" Command="{Binding QuickSetProgressCommand}" CommandParameter="25" Margin="2" Background="#FF9C27B0" Foreground="White"/>
                        <Button Content="50%" Command="{Binding QuickSetProgressCommand}" CommandParameter="50" Margin="2" Background="#FF9C27B0" Foreground="White"/>
                        <Button Content="75%" Command="{Binding QuickSetProgressCommand}" CommandParameter="75" Margin="2" Background="#FF9C27B0" Foreground="White"/>
                        <Button Content="100%" Command="{Binding QuickSetProgressCommand}" CommandParameter="100" Margin="2" Background="#FF9C27B0" Foreground="White"/>
                    </UniformGrid>
                </StackPanel>

                <Button Content="Открыть материалы" Command="{Binding OpenMaterialsCommand}" 
                        Width="120" Height="35" Margin="20,0,0,0" Background="#FF9C27B0" Foreground="White"
                        IsEnabled="{Binding SelectedCourse, Converter={StaticResource NullToBooleanConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>